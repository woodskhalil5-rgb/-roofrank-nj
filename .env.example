# ---------------------------------------------------------------------------
# Destiny Marketing Group — Real Estate Intelligence Platform
# Copy to .env.local for development. Never commit real values.
# ---------------------------------------------------------------------------

# Supabase (independent project: destiny-realty-intel)
NEXT_PUBLIC_SUPABASE_URL=https://xicywfiquzqvlulwirln.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public site origin, used in notification links and canonical URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Administrator approval notifications (mandatory recipient per the brief)
ADMIN_NOTIFICATION_EMAIL=admin@destinymarketinggroup.com

# Email delivery. Until a provider is configured, notifications stay queued in
# notification_outbox and remain visible in the dashboard — they are not lost.
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM=

# Protects cron/drain routes. Generate with: openssl rand -hex 32
JOB_SECRET=

# ---------------------------------------------------------------------------
# Jersey Home Pros — SEPARATE SYSTEM.
# Leave unset until JHP's real integration surface has been verified with its
# administrator. The platform refuses to transmit while unset: requests stay
# queued rather than being sent to a guessed endpoint.
# ---------------------------------------------------------------------------
JHP_API_BASE_URL=
JHP_API_KEY=
JHP_INTEGRATION_ENABLED=false
